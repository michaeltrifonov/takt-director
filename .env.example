# takt-director — preconfigured for the DEVELOPMENT environment (team testing).
# Setup:  cp .env.example .env  →  set REPO_PATH  →  npm run dev
# (For production, swap TAKT_SERVER_URL + SUPABASE_* to the prod values.)

# ── REQUIRED: the local repo Takt drives ─────────────────────
# If unset, it falls back to the daemon's own working dir (the takt-director
# folder when launched via `npm run dev`) — almost never what you want. Set it
# to the absolute path of the project you want Takt to work in.
REPO_PATH=/abs/path/to/your/project

# ── Takt server the daemon dials (development) ───────────────
TAKT_SERVER_URL=https://<your-takt-dev-server>.up.railway.app

# ── Supabase login — development project (publishable key is public) ──
SUPABASE_URL=https://jxcyoqepvhjvdwdxxzav.supabase.co
SUPABASE_ANON_KEY=sb_publishable_kaxD-PUje5seEh-xQQBgdA_eXzi26yb
# OAUTH_PROVIDER=google           # or apple
# OAUTH_CALLBACK_PORT=4318        # must be whitelisted in the dev project's Auth redirect URLs

# ── Claude Agent SDK (the coder) ─────────────────────────────
# Leave unset to use your logged-in Claude Code subscription (recommended).
# Setting this bills the API/pay-as-you-go instead.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Review gate (the Session classifies; the server auto-denies in tool mode) ──
# REVIEW_TOOLS=
# REVIEW_BASH_PATTERNS=git push,git commit,rm -rf,deploy,npm publish,supabase db push,gh pr

# ── ask_takt consult shim (Claude -> Takt), optional ─────────
# Needs the server's CONSULT_API_KEY to work.
# TAKT_API_KEY=
