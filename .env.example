# takt-director configuration.
# Setup:  cp .env.example .env  →  set REPO_PATH (+ DIRECTOR_URL)  →  npm run dev

# ── REQUIRED: the local repo the director drives ─────────────
# If unset, it falls back to the daemon's own working dir (the takt-director
# folder when launched via `npm run dev`) — almost never what you want. Set it
# to the absolute path of the project you want driven.
REPO_PATH=/abs/path/to/your/project

# ── Director server the daemon dials ─────────────────────────
# DIRECTOR_URL=http://localhost:3001

# ── Daemon auth: a static token, or a one-time OAuth (PKCE) browser login ──
# DIRECTOR_TOKEN=
# OAUTH_AUTHORIZE_URL=https://auth.example.com/oauth/authorize
# OAUTH_TOKEN_URL=https://auth.example.com/oauth/token
# OAUTH_CLIENT_ID=
# OAUTH_SCOPES=openid email offline_access
# OAUTH_CALLBACK_PORT=4318        # http://localhost:4318/callback must be an allowed redirect URI

# ── Claude Agent SDK (the coder) ─────────────────────────────
# Leave unset to use your logged-in Claude Code subscription (recommended).
# Setting this bills the API/pay-as-you-go instead.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Review gate (the Session classifies; the server auto-denies in tool mode) ──
# REVIEW_TOOLS=
# REVIEW_BASH_PATTERNS=git push,git commit,rm -rf,deploy,npm publish,supabase db push,gh pr

# ── Visual QA (Playwright MCP; on by default) ────────────────
# PLAYWRIGHT_MCP_ENABLED=false

# ── Thrash breaker (0 disables a limit; repeats on by default) ──
# THRASH_MAX_REPEATS=6
# THRASH_MAX_TOOL_CALLS=0
# THRASH_MAX_TOKENS=0

# ── ask_takt consult shim (Claude -> director), optional ─────
# Needs the server's consult API key to work.
# CONSULT_API_URL=                # defaults to DIRECTOR_URL
# CONSULT_PATH=/api/consult/ask
# CONSULT_API_KEY=
