{
  "name": "takt-director",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "takt-director: a local daemon that dials a director server and lets an orchestrating AI proactively drive a local Claude Code session via the Claude Agent SDK. Director, not coder — Claude Code stays the agent.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "mcp:takt": "tsx src/consult/taktMcpServer.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.169",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "socket.io-client": "^4.7.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.6"
  }
}
